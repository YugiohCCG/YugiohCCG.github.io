{
  "dependencies": {
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "query-string": "^9.2.2",
    "react-router-dom": "^7.8.0",
    "react-window": "^1.8.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@n1xx1/ocgcore-wasm": "npm:@jsr/n1xx1__ocgcore-wasm@^0.1.3",
    "@types/node": "^24.5.0",
    "@types/query-string": "^6.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^9.1.2",
    "luaparse": "^0.3.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "source-map": "^0.7.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "predev": "python -B scripts/generate_archetype_catalog.py && python -B scripts/generate_website_metadata.py && node scripts/sync-public-cards.cjs",
    "dev": "vite",
    "prebuild": "python -B scripts/generate_archetype_catalog.py && python -B scripts/generate_website_metadata.py && node scripts/sync-public-cards.cjs",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "preview": "vite preview",
    "sync:public-cards": "node scripts/sync-public-cards.cjs",
    "sync:website-metadata": "python -B scripts/generate_website_metadata.py",
    "sync:archetypes": "python -B scripts/generate_archetype_catalog.py",
    "sync:yugioh-catalog": "python -B scripts/sync_yugioh_catalog.py",
    "verify:public-cards": "node scripts/sync-public-cards.cjs --check",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "label:tcg": "node scripts/label-tcg-cards.js",
    "sync:omega:banlist": "node scripts/sync-omega-ccg-banlist.mjs",
    "sync:ygo:draft": "node scripts/sync-ygo-draft-pool.mjs",
    "release:omega": "python scripts/release_omega_assets.py",
    "release:omega:with-omega-install": "python scripts/release_omega_assets.py --use-omega-install",
    "release:omega:publish": "python scripts/release_omega_assets.py --recompile-installer --push",
    "release:omega:stage": "python scripts/release_omega_assets.py --push --commit-message \"Update Omega CCG add-on assets (installer recompile pending)\"",
    "release:omega:installer": "python scripts/release_omega_assets.py --skip-db --skip-images --recompile-installer --push --commit-message \"Recompile Omega CCG installer EXE\"",
    "test:omega": "python scripts/release_omega_assets.py --use-omega-install --export-only --overwrite",
    "release:omega:db-only": "python scripts/release_omega_assets.py --skip-images",
    "release:omega:images-only": "python scripts/release_omega_assets.py --skip-db",
    "package:omega:scripts": "python scripts/package_omega_ccg_scripts.py",
    "verify:omega:scripts": "python scripts/package_omega_ccg_scripts.py --check",
    "verify:omega:callbacks": "python scripts/verify_omega_callbacks.py",
    "verify:omega:archetypes": "python scripts/verify_omega_archetypes.py",
    "verify:omega:messages": "python scripts/verify_omega_message_routes.py --report scripts/output/omega_message_route_manifest.json",
    "verify:omega:headless": "python scripts/verify_omega_headless_registration.py",
    "verify:omega": "python scripts/verify_omega_release.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:ccg": "python scripts/run_ccg_qa.py",
    "qa:ccg:fast": "python scripts/run_ccg_qa.py --fast",
    "qa:ccg:ci": "python scripts/run_ccg_qa.py --ci --no-report",
    "verify:ccg:contracts": "node --no-warnings scripts/verify_ccg_effect_contracts.cjs",
    "audit:effects:index": "python scripts/build_official_omega_effect_index.py",
    "audit:effects:verify": "python scripts/verify_effect_by_effect_audit.py",
    "test:omega:record": "python scripts/record_omega_manual_test.py"
  },
  "engines": {
    "node": ">=18.18"
  }
}
